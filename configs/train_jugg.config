# ──────────────────────────────────────────────────────────────────────────────
# configs/test_train_1_config.yml
# DreamBooth LoRA SDXL Inpainting – Interior Design
# ★ Uses Juggernaut-XL-v9 merged into SDXL Inpainting for better lighting/aesthetics
# ★ Optimized for 3× RTX 5090 (32 GB each) + DeepSpeed ZeRO-2
# ──────────────────────────────────────────────────────────────────────────────

model:
  pretrained_model_name_or_path: "diffusers/stable-diffusion-xl-1.0-inpainting-0.1"
  pretrained_vae_model_name_or_path: null
  pretrained_controlnet_model_name_or_path: "diffusers/controlnet-depth-sdxl-1.0"

  # ★ Selective merge: only attention/transformer layers from Juggernaut
  # - Keeps ALL ResNet/conv/conditioning layers from inpainting model
  # - Merges only attention+FF layers for aesthetic quality (lighting, color)
  # - Set null to disable merge (use pure inpainting model)
  aesthetic_model_path: "RunDiffusion/Juggernaut-XL-v9"
  aesthetic_merge_alpha: 0.3   # 0.3 = 30% Juggernaut attention + 70% Inpainting attention

# ── Data ──────────────────────────────────────────────────────────────────────
data:
  dataset_dir: "/home/diffusion/SDXL_Lora/new_data"
  images_subdir:   "images"
  masks_subdir:    "masks"
  depths_subdir:   "depth_map"
  captions_subdir: "captions"

  train_ratio: 0.95
  val_ratio:   0.05

  center_crop:   false
  random_flip:   false

  num_workers:   2
  persistent_workers: true
  repeats:       1
  prefetch_factor: 8

  preload_to_ram: false
  precompute_latents: false
  latent_cache_batch_size: 16

  mask_min_area: 0.1
  mask_max_area: 0.5
  mask_dilation_pct: 0.0
  mask_max_area_pct: 0.70

# ── DreamBooth ────────────────────────────────────────────────────────────────
dreambooth:
  instance_prompt: "interior design, modern furniture, professional ambient lighting, high quality photograph, 8k"

  with_prior_preservation: false
  prior_loss_weight: 1.0
  class_prompt: "a room"
  class_data_dir: "data/class_images"
  num_class_images: 200

  train_text_encoder: false

# ── LoRA ──────────────────────────────────────────────────────────────────────
lora:
  rank:       32
  alpha:      32
  dropout:    0.08
  use_dora:   false
  rank_ff:    32
  rank_xattn: 16

# ── Loss weights ──────────────────────────────────────────────────────────────
loss_weights:
  diffusion_weight:  0.80
  pixel_weight:      0.05
  perceptual_weight: 0.05
  clip_weight:       0.0
  boundary_weight:   0.1
  depth_weight:      0.0
  semantic_weight:   0.0
  aux_resolution_scale: 0.3
  aux_loss_every_n_steps: 100

# ── Training ──────────────────────────────────────────────────────────────────
training:
  output_dir: "outputs/sdxl-inpaint-lora-juggernaut"
  resolution: 1024

  train_batch_size: 3
  sample_batch_size: 3
  gradient_accumulation_steps: 4
  gradient_checkpointing: true

  num_train_epochs: 50
  max_train_steps: null

  learning_rate: 5.0e-5
  text_encoder_lr: 1.0e-5
  lr_scheduler: "cosine_with_restarts"
  lr_warmup_steps: 200
  lr_num_cycles: 10
  lr_power: 1.0

  optimizer: "adamw"
  use_8bit_adam: true
  adam_beta1: 0.9
  adam_beta2: 0.999
  adam_weight_decay: 1.0e-2
  adam_epsilon: 1.0e-8
  max_grad_norm: 1.0

  seed: 42
  mixed_precision: "bf16"

  enable_xformers: true
  do_edm_style_training: false
  snr_gamma: 5.0
  cfg_dropout_rate: 0.1

  checkpointing_steps: 250
  checkpoints_total_limit: 5
  resume_from_checkpoint: null
  early_stopping_patience: 3

  output_kohya_format: false

# ── Validation ────────────────────────────────────────────────────────────────
validation:
  validation_steps: 250
  num_validation_images: 10
  num_inference_steps: 25
  guidance_scale: 8.0
  strength: 0.95
  controlnet_conditioning_scale: 0.5
  mask_dilation_pct: 0.0
  mask_max_area_pct: 0.70

# ── Logging / WandB ───────────────────────────────────────────────────────────
logging:
  report_to: "wandb"
  run_name: "sdxl-inpaint-lora-juggernaut"

  wandb_project:  "sdxl-inpaint-dreambooth"
  wandb_entity:   null
  wandb_run_name: "sdxl-inpaint-juggernaut-merge"
  wandb_tags:
    - "sdxl"
    - "inpainting"
    - "lora"
    - "interior-design"
    - "juggernaut-xl-v9"
    - "merged"
  wandb_notes: "SDXL Inpainting + 70% Juggernaut-XL-v9 merged UNet, 3x RTX 5090"
  wandb_api_key: null

  log_every_n_steps: 10
  best_loss_window_size: 50
